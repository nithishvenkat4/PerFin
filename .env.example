# ==========================================
# FinMate 2.0 — Environment Configuration
# ==========================================

# Core Application
APP_NAME=FinMate
APP_ENV=development
APP_VERSION=2.0.0
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production-finmate-2026

# FastAPI Python Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database (Primary Financial Engine)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/finmate_db

# Fallback SQLite Database URL (Auto-fallback enabled in app/core/config.py)
# SQLITE_DATABASE_URL=sqlite:///./finmate.db

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Logging
LOG_LEVEL=INFO

# ==========================================
# Node.js + MongoDB Microservice (Lab Module)
# ==========================================
NODE_PORT=5000
MONGODB_URI=mongodb://localhost:27017/finmate
NODE_API_URL=http://localhost:5000

# ==========================================
# React Frontend Environment Variables
# ==========================================
VITE_API_URL=http://localhost:8000
VITE_NODE_URL=http://localhost:5000

# ==========================================
# AI / ML Intelligence Configuration
# ==========================================
# Options: gemini, openai, mock (default: mock for zero-cost offline development)
AI_PROVIDER=gemini
LLM_PROVIDER=gemini
# Gemini Models: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
# OpenAI Models: gpt-4o-mini, gpt-4o
LLM_MODEL=gemini-1.5-flash
# Get a free Gemini API key at https://aistudio.google.com/app/apikey
LLM_API_KEY=your_gemini_or_openai_api_key_here
GEMINI_API_KEY=
LLM_BASE_URL=
# Options: local, openai (default: local TF-IDF cosine embeddings)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=tfidf-sublinear
VECTOR_STORE=in_memory
